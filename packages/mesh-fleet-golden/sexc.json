    "@ajax/mesh-abi-fnv": "workspace:*",
    "@ajax/mesh-member-list": "workspace:*",
    "@ajax/mesh-sched-member": "workspace:*",
    "@ajax/mesh-sched-needs": "workspace:*",
    "@ajax/mesh-sched-weights": "workspace:*",
    "@ajax/mesh-sched-score": "workspace:*",
    "@ajax/mesh-sched-place": "workspace:*",
    "@ajax/mesh-sched-tracker": "workspace:*",
    "@ajax/mesh-fleet-doc": "workspace:*",
    "@ajax/mesh-fleet-persist": "workspace:*",
    "@ajax/mesh-fleet-core": "workspace:*"
  }
}
