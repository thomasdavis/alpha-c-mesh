  "keywords": [
    "mesh",
    "alphaos",
    "fleet",
    "placement",
    "split",
    "assignment"
  ],
  "cflags": ["-std=c17", "-D_XOPEN_SOURCE=700"],
  "dependencies": {
    "@ajax/mesh-check": "workspace:*", "@ajax/mesh-text": "workspace:*", "@ajax/mesh-parse": "workspace:*", "@ajax/rust-fmt": "workspace:*", "@ajax/mesh-abi-base": "workspace:*", "@ajax/mesh-abi-placement": "workspace:*"
  }
