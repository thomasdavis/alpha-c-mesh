    "@ajax/mesh-abi-ring": "workspace:*",
    "@ajax/mesh-abi-view-heap": "workspace:*",
    "@ajax/mesh-abi-ext": "workspace:*",
    "@ajax/mesh-abi-base": "workspace:*",
    "@ajax/mesh-log": "workspace:*",
