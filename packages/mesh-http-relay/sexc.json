{
  "name": "@ajax/mesh-http-relay",
  "version": "0.1.0",
  "description": "meshd's HTTP port: request heads relayed to the GPU http program, and the routes meshd answers itself (the views, infer, render)",
  "kind": "library",
  "license": "MIT",
  "author": "Thomas Davis (C port); Richard Safier (alpha-rust-mesh)",
  "repository": "https://github.com/thomasdavis/alpha-c-mesh",
  "homepage": "https://github.com/thomasdavis/alpha-c-mesh/tree/main/packages/mesh-http-relay",
  "keywords": [
    "mesh",
    "alphaos",
    "http",
    "relay",
    "daemon"
  ],
  "targets": [
    "host"
  ],
  "cflags": [
    "-D_XOPEN_SOURCE=700",
    "-pthread"
  ],
  "ldflags": [
    "-pthread"
  ],
  "dependencies": {
    "@ajax/mesh-shared": "workspace:*",
    "@ajax/mesh-control": "workspace:*",
    "@ajax/mesh-views": "workspace:*",
    "@ajax/mesh-inferd": "workspace:*",
    "@ajax/mesh-infer-request": "workspace:*",
    "@ajax/mesh-log": "workspace:*",
    "@ajax/mesh-abi": "workspace:*",
    "@ajax/mesh-buf": "workspace:*",
    "@ajax/mesh-rsfmt": "workspace:*",
    "@ajax/mesh-chan": "workspace:*",
    "@ajax/mesh-check": "workspace:*"
  }
}
