{
  "name": "@ajax/mesh-fleetd",
  "version": "0.1.0",
  "description": "meshd's fleet member over the daemon's shared state: the fleet thread's host (status block, mailbox, catalog, driver, jobs), the reconciler's driver actions, the peer channel and link queue bridges, and the F_PERF report",
  "kind": "library",
  "license": "MIT",
  "author": "Thomas Davis (C port); Richard Safier (alpha-rust-mesh)",
  "repository": "https://github.com/thomasdavis/alpha-c-mesh",
  "homepage": "https://github.com/thomasdavis/alpha-c-mesh/tree/main/packages/mesh-fleetd",
  "keywords": ["mesh", "alphaos", "fleet", "cluster", "reconcile", "daemon"],
  "targets": ["host"],
  "cflags": ["-D_XOPEN_SOURCE=700", "-pthread"],
  "ldflags": ["-pthread"],
  "dependencies": {
    "@ajax/mesh-abi": "workspace:*",
    "@ajax/mesh-shared": "workspace:*",
    "@ajax/mesh-chan": "workspace:*",
    "@ajax/mesh-reply": "workspace:*",
    "@ajax/mesh-host-block": "workspace:*",
    "@ajax/mesh-net-counters": "workspace:*",
    "@ajax/mesh-mailbox": "workspace:*",
    "@ajax/mesh-views": "workspace:*",
    "@ajax/mesh-prog-table": "workspace:*",
    "@ajax/mesh-samplers": "workspace:*",
    "@ajax/mesh-loader": "workspace:*",
    "@ajax/mesh-manifest": "workspace:*",
    "@ajax/mesh-manifest-needs": "workspace:*",
    "@ajax/mesh-log": "workspace:*",
    "@ajax/mesh-buf": "workspace:*",
    "@ajax/mesh-rsfmt": "workspace:*",
    "@ajax/mesh-mt": "workspace:*",
    "@ajax/mesh-cluster-conf": "workspace:*",
    "@ajax/mesh-peer-codec": "workspace:*",
    "@ajax/mesh-peer-link": "workspace:*",
    "@ajax/mesh-peer-relay": "workspace:*",
    "@ajax/mesh-place-wire": "workspace:*",
    "@ajax/mesh-reconcile": "workspace:*",
    "@ajax/mesh-fleet-doc": "workspace:*",
    "@ajax/mesh-fleet-edit": "workspace:*",
    "@ajax/mesh-fleet-plan": "workspace:*",
    "@ajax/mesh-fleet-store": "workspace:*",
    "@ajax/mesh-fleet-persist": "workspace:*",
    "@ajax/mesh-sched-member": "workspace:*",
    "@ajax/mesh-sched-report": "workspace:*",
    "@ajax/mesh-sched-place": "workspace:*",
    "@ajax/mesh-sched-tracker": "workspace:*",
    "@ajax/mesh-jobd": "workspace:*",
    "@ajax/mesh-jobs-node": "workspace:*",
    "@ajax/mesh-check": "workspace:*"
  }
}
