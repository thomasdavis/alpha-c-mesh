  "homepage": "https://github.com/thomasdavis/alpha-c-mesh/tree/main/packages/mesh-assemble",
  "keywords": ["mesh", "alphaos", "pathtrace", "assembly", "deterministic"],
  "dependencies": {
    "@ajax/mesh-check": "workspace:*", "@ajax/mesh-strbuf": "workspace:*", "@ajax/mesh-omap": "workspace:*",
    "@ajax/mesh-jobs-id": "workspace:*", "@ajax/mesh-jobs-spec": "workspace:*", "@ajax/mesh-abi-ops": "workspace:*",
    "@ajax/mesh-ftz": "workspace:*", "@ajax/pathtrace-scene": "workspace:*", "@ajax/pathtrace-job-scene": "workspace:*",
    "@ajax/pathtrace-view": "workspace:*", "@ajax/pathtrace-digest": "workspace:*", "@ajax/pathtrace-z": "workspace:*",
    "@ajax/mesh-ref-pathtrace": "workspace:*", "@ajax/mesh-ref-sha256d": "workspace:*", "@ajax/mesh-assemble-bmp": "workspace:*"
  }
