{
  "name": "@ajax/mesh-blobd",
  "version": "0.1.0",
  "description": "The blob thread's logic: this member's payloads kept durably, pushes to the copy holders with a window, fetches with failover, image assemblies, and `render`",
  "kind": "library",
  "targets": [
    "host"
  ],
  "license": "MIT",
  "author": "Thomas Davis (C port); Richard Safier (alpha-rust-mesh)",
  "repository": "https://github.com/thomasdavis/alpha-c-mesh",
  "homepage": "https://github.com/thomasdavis/alpha-c-mesh/tree/main/packages/mesh-blobd",
  "keywords": [
    "mesh",
    "alphaos",
    "blobs",
    "replication",
    "pathtrace"
  ],
  "cflags": [
    "-D_XOPEN_SOURCE=700"
  ],
  "dependencies": {
    "@ajax/mesh-check": "workspace:*",
    "@ajax/mesh-strbuf": "workspace:*",
    "@ajax/mesh-omap": "workspace:*",
    "@ajax/mesh-abi-peer-frames": "workspace:*",
    "@ajax/mesh-jobs-id": "workspace:*",
    "@ajax/mesh-jobs-spec": "workspace:*",
    "@ajax/mesh-blobs-store": "workspace:*",
    "@ajax/mesh-blobs-frame": "workspace:*",
    "@ajax/mesh-blobs-durable": "workspace:*",
    "@ajax/mesh-assemble": "workspace:*",
    "@ajax/mesh-ref-sha256d": "workspace:*",
    "@ajax/pathtrace-scene": "workspace:*",
    "@ajax/pathtrace-z": "workspace:*",
    "@ajax/pathtrace-view": "workspace:*",
    "@ajax/pathtrace-default-scene": "workspace:*"
  }
}
