  "homepage": "https://github.com/thomasdavis/alpha-c-mesh/tree/main/packages/mesh-inproc",
  "keywords": [
    "mesh",
    "alphaos",
    "inproc",
    "kcheck",
    "backend",
    "driver"
  ],
  "cflags": [
    "-D_GNU_SOURCE"
  ],
