{
  "name": "@ajax/mesh-shared",
  "version": "0.1.0",
  "description": "meshd's shared state between its threads, and the messages they send the driver, the fleet thread and the jobs thread",
  "kind": "library",
  "license": "MIT",
  "author": "Thomas Davis (C port); Richard Safier (alpha-rust-mesh)",
  "repository": "https://github.com/thomasdavis/alpha-c-mesh",
  "homepage": "https://github.com/thomasdavis/alpha-c-mesh/tree/main/packages/mesh-shared",
  "keywords": [
    "mesh",
    "alphaos",
    "daemon",
    "state",
    "commands",
    "threads"
  ],
  "targets": [
    "host"
  ],
  "cflags": [
    "-D_XOPEN_SOURCE=700",
    "-pthread"
  ],
  "ldflags": [
    "-pthread"
  ],
  "dependencies": {
    "@ajax/mesh-mailbox": "workspace:*",
    "@ajax/mesh-abi": "workspace:*",
    "@ajax/mesh-host-block": "workspace:*",
    "@ajax/mesh-loader": "workspace:*",
    "@ajax/mesh-chan": "workspace:*",
    "@ajax/mesh-reply": "workspace:*",
    "@ajax/mesh-buf": "workspace:*",
    "@ajax/mesh-rsfmt": "workspace:*",
    "@ajax/mesh-views": "workspace:*",
    "@ajax/mesh-infer-svc": "workspace:*",
    "@ajax/mesh-jobs-frame": "workspace:*",
    "@ajax/mesh-log": "workspace:*",
    "@ajax/mesh-check": "workspace:*"
  }
}
