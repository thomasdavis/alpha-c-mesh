{
  "name": "@ajax/mesh-manifest",
  "version": "0.1.0",
  "description": "A program's manifest (program.toml): the struct, the parser and every validation, with the Rust's error messages",
  "kind": "library",
  "license": "MIT",
  "author": "Thomas Davis (C port); Richard Safier (alpha-rust-mesh)",
  "repository": "https://github.com/thomasdavis/alpha-c-mesh",
  "homepage": "https://github.com/thomasdavis/alpha-c-mesh/tree/main/packages/mesh-manifest",
  "keywords": [
    "mesh",
    "alphaos",
    "manifest",
    "program",
    "parser"
  ],
  "cflags": [
    "-D_XOPEN_SOURCE=700"
  ],
  "ldflags": [
    "-lm"
  ],
  "dependencies": {
