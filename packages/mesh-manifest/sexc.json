    "@ajax/mesh-toml": "workspace:*",
    "@ajax/mesh-manifest-needs": "workspace:*",
    "@ajax/mesh-abi-base": "workspace:*",
    "@ajax/mesh-abi-backend": "workspace:*",
    "@ajax/mesh-abi-program-table": "workspace:*",
    "@ajax/mesh-abi-control-block": "workspace:*",
    "@ajax/mesh-abi-ring": "workspace:*",
    "@ajax/mesh-abi-view-heap": "workspace:*",
    "@ajax/mesh-abi-input-queue": "workspace:*",
    "@ajax/mesh-abi-ext": "workspace:*",
    "@ajax/mesh-abi-placement": "workspace:*",
    "@ajax/mesh-abi-peer-sizes": "workspace:*",
    "@ajax/mesh-abi-pipe-ring": "workspace:*",
    "@ajax/mesh-abi-name": "workspace:*",
    "@ajax/mesh-abi-node": "workspace:*",
    "@ajax/mesh-check": "workspace:*"
  }
}
