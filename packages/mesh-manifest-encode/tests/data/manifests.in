# lifecheck: a contract this meshd does not run (refused before any JIT)
name       = "badabi"
abi        = 7
nodes      = 1
backends   = ["cuda", "metal", "wasm"]
# lifecheck: corrupt.ptx is hello's PTX cut in half by build.sh (nvJitLink must refuse it)
name       = "corrupt"
abi        = 6
nodes      = 1
backends   = ["cuda", "metal", "wasm"]
# lifecheck: a 4 KiB local frame; loaded stopped, then started while others run
name       = "deep"
abi        = 6
nodes      = 1
policy     = "on_demand"
autostart  = false
# lifecheck: over-occupancy (48 KiB shared per block x 32 nodes)
name       = "fat"
abi        = 6
nodes      = 32
policy     = "on_demand"
# lifecheck: continuous, one task in flight; gaps measured on the GPU clock
name       = "gap"
abi        = 6
view_bytes = 0x2000
snap_bytes = 0x28
nodes      = 1
policy     = "continuous"
fanout     = 1
in_flight  = "batch"
input      = 64
request    = "0x1100:0x100,0x1200:0x100"
counters   = ["tasks", "", "", ""]
fields     = ["magic:u32:0x0", "tasks:u32:0x4", "max_gap_us:u32:0x10", "gaps:u32:0x14", "over_10ms:u32:0x18"]
autostart  = true
backends   = ["cuda", "metal", "wasm"]
# the wasm image (fixtures/wasm) is one for every fixture: param 3 selects gap there (the GPU images ignore it)
param      = 3
# lifecheck: hello with view_abi 2 (an upgrade to it zeroes the view and runs OP_INIT)
name       = "hello"
abi        = 6
view_bytes = 0x1000
view_abi   = 2
snap_bytes = 0x40
nodes      = 2
policy     = "on_demand"
counters   = ["tasks", "inits", "", ""]
fields     = ["magic:u32:0x0", "last_arg:u32:0x4", "last_result:u32:0x8"]
autostart  = true
backends   = ["cuda", "metal", "wasm"]
# the wasm image (fixtures/wasm) is one for every fixture: param 2 selects hello-abi2 there (the GPU images ignore it)
param      = 2
# lifecheck: hello, image B (same view contract: an upgrade keeps the view)
name       = "hello"
abi        = 6
view_bytes = 0x1000
view_abi   = 1
snap_bytes = 0x40
nodes      = 2
policy     = "on_demand"
counters   = ["tasks", "inits", "", ""]
fields     = ["magic:u32:0x0", "last_arg:u32:0x4", "last_result:u32:0x8", "marker:u32:0xc"]
autostart  = true
backends   = ["cuda", "metal", "wasm"]
# the wasm image (fixtures/wasm) is one for every fixture: param 1 selects hello-b there (the GPU images ignore it)
param      = 1
# lifecheck: wide, a multi-warp node (16 warps = 512 threads; task 0 arg = 130816 + arg)
name         = "wide"
abi          = 6
view_bytes   = 0x1000
nodes        = 4
warps        = 16
shared_bytes = 0x400
policy       = "on_demand"
counters     = ["tasks", "", "", ""]
backends     = ["cuda", "metal"]
# A native worker program, macOS only (Core ML): elsewhere the catalog has no
# binary for it and a load answers `unsupported`.
# build-os: Darwin
name        = "ane"
abi         = 6
backends    = ["native"]
view_bytes  = 0x1000
snap_bytes  = 0x100
nodes       = 1
# `task ane 0 <unit>`: a batch of inferences (0 cpu, 1 cpu+ane, 2 cpu+gpu, 3 all);
# `task ane 3 0`: MLComputePlan's layers on the ANE; `task ane 4 0`: outputs vs CPU-only.
counters    = ["inferences", "", "", ""]
fields      = ["channels:u32:0x04", "side:u32:0x08", "layers:u32:0x0c", "gflop:f32:0x10", "batch:u32:0x14", "cpu_us:u32:0x40", "cpu_ips:f32:0x48", "cpu_cpums:f32:0x50", "ane_us:u32:0x60", "ane_ips:f32:0x68", "ane_cpums:f32:0x70", "gpu_us:u32:0x80", "gpu_ips:f32:0x88", "all_us:u32:0xa0", "ane_layers:u32:0xc0", "layers_planned:u32:0xc4", "diff_ane:f32:0xd0", "diff_gpu:f32:0xd4"]
autostart   = false
# blocks: the block collectives of a multi-warp node (mesh-rt block.rs,
# mesh_rt.h), checked by kcheck bitwise against mesh-ref::block on every GPU.
# op 0 (OP_TASK) arg = seed: thread t takes mesh_ref::block::test_values(seed, t)
# and the node computes every reduction, scan, a broadcast and a shared-memory
# round trip; the results go to region ticket % 4 of the view (layout below).
# op 2: warps 1.. return at once while warp 0 runs a warp sum (the node loop's
# barrier must still be reached by every thread: no hang).
# View: 0x0 magic, 0x4 tasks; region r at 0x1000 + 0x10000 r: a 0x40-byte header
# (threads, f32 sum, f32 max, u32 sum, u32 max, u64 sum, u64 max, broadcast,
# node, warps), then 48 bytes a thread (f32 scan incl/excl, u32 scan incl/excl,
# u64 scan incl/excl, the shared word read back from thread threads-1-t).
# variants/blocks-w4.toml: the same image with 4 warps a node.
name         = "blocks"
abi          = 6
view_bytes   = 0x41000
nodes        = 4
warps        = 32
shared_bytes = 0x1000
policy       = "on_demand"
counters     = ["tasks", "early", "", ""]
fields       = ["magic:u32:0x0", "tasks:u32:0x4"]
backends     = ["cuda", "metal"]
# doom: a raycaster, 4 tasks a frame, the pose and keys on the GPU
# (layout: mesh_abi::v2::views::doom; docs/plan-program-loading.md §3.8)
name       = "doom"
abi        = 6
view_bytes = 0x4000
view_abi   = 2
snap_bytes = 0x3100
nodes      = 4
policy     = "periodic"
hz         = 30
fanout     = 4
in_flight  = "batch"
input      = 64
counters   = ["frames", "keys", "stalls", "follows"]
fields     = ["pos_x:f32:0x0", "pos_y:f32:0x4", "dir_x:f32:0x8", "dir_y:f32:0xc", "plane_x:f32:0x10", "plane_y:f32:0x14", "frame:u32:0x20", "keys:u32:0x28", "shown:u32:0x2000", "place:u32:0x2004", "lat_us:u32:0x200c"]
autostart  = true
backends   = ["cuda", "metal"]
# Placement across a cluster (mesh-abi v2 "placement"): pin to one machine, or
# split its 4 parts of 32 columns over several (the owner of part 0 owns the pose).
place       = "split"
place_state = ["0x0:0x24", "0x28:0x4", "0x100:0x400"]
place_frame = 0x20
place_out   = ["0x1000:0x200", "0x1400:0x200", "0x1800:0x200", "0x1c00:0x200"]
place_show  = 0x2000
# A native worker program (README "Native workers"): an executable per target,
# built by scripts/build-programs.sh into <catalog>/gemm/<target triple>/gemm.
name        = "gemm"
abi         = 6
backends    = ["native"]
view_bytes  = 0x8000
snap_bytes  = 0x40
nodes       = 1
# Jobs (plan F5): each item (OP_JOB) is one size^3 GEMM (the view's size word;
# OP_INIT sets 1024, a job's `setup 7:<n>` another), result its microseconds,
# job_out (n, GFLOP/s): `job submit gemm items 200 setup 7:2048`.  On demand:
# `task gemm 0 <n>` runs one of n, `task gemm 4 <n>` the plain Rust loop,
# `task gemm 5 <n>` the fast path on one thread, `task gemm 3 <n>` (n <= 64)
# writes C to the view at 0x1000 for the reference check.
policy      = "job"
job_out     = "0x6000:8"
counters    = ["gemms", "gflop", "plain", "checks"]
fields      = ["size:u32:0x04", "n:u32:0x08", "us:u32:0x0c", "gflops:f32:0x10", "best:f32:0x14", "plain:f32:0x18", "single:f32:0x1c", "impl:u32:0x20", "threads:u32:0x24", "runs:u32:0x28"]
autostart   = false
# gpt2: GPT-2 124M inference, a native worker program (README "GPT-2 across
# the fleet"; docs/plan-disagg-inference.md).  This manifest is the
# monolithic role (prefill and decode in one process); variants/ has the
# disaggregated roles, gpt2-prefill and gpt2-decode, the same binary.
# Modes: fast / fast16 (candle on CUDA or Metal), exact (programs/gpt2x, the
# exact-mode kernels, loaded in-process: bitwise == mesh_ref::gpt2 on every
# GPU), exact-cpu (mesh_ref::gpt2).  The checkpoint: $MESH_MODELS/gpt2
# (meshd --models DIR), openai-community/gpt2, sha256-checked at start.
# Requests: `infer` on the control port, GET /infer on meshd's http; the
# worker's service listens on the member's peer port (control port when
# single) + param.  A periodic task copies its numbers into the view.
# hash-also: programs/gpt2x crates/mesh-host crates/mesh-rt crates/mesh-rt-metal
name        = "gpt2"
abi         = 6
backends    = ["native"]
device      = "gpu"
view_bytes  = 0x1000
snap_bytes  = 0x80
nodes       = 1
policy      = "periodic"
hz          = 4
param       = 100
counters    = ["polls", "requests", "errors", "tokens"]
fields      = ["role:u32:0x04", "requests:u32:0x08", "errors:u32:0x0c", "ttft_ms:f32:0x10", "prefill_ms:f32:0x14", "tok_s:f32:0x18", "kv_ms:f32:0x1c", "kv_mb_total:f32:0x20", "kv_mb:f32:0x24", "prompt:u32:0x28", "gen:u32:0x2c", "peer:u32:0x30", "mode:u32:0x34", "tokens:u32:0x38", "busy:u32:0x3c", "kv_gbps:f32:0x40"]
replicas    = "all"
migrate     = "restart"
autostart   = false
# gpt2x: GPT-2 124M's exact-mode kernels on the GPU (CUDA and Metal), the
# exact path of programs/gpt2 (its worker loads this image in-process through
# mesh-host's backend: mesh-host gpt2x.rs is the host side).  Every op follows
# mesh_ref::gpt2 operation for operation (FTZ, correctly rounded, unfused,
# fixed sum orders; exp/tanh/sqrt from + - * /), so the logits and the KV
# cache are bitwise the reference's on every GPU (kcheck GX*).  8-warp nodes;
# the weights (f32, 498 MB), the KV cache (12 x 1024 x 768 x 2 f32) and the
# activations of up to 1024 rows live in the scratch.  Ops and the view:
# mesh_abi::v2::views::gpt2x.
name          = "gpt2x"
abi           = 6
view_bytes    = 0x700000
nodes         = "fit"
warps         = 8
shared_bytes  = 0x4200
scratch_bytes = 0x24200000
policy        = "on_demand"
fanout        = 32
counters      = ["tasks", "rows", "tiles", "chunks"]
fields        = ["magic:u32:0x0"]
backends      = ["cuda", "metal"]
# hashjob: a wasm CPU job program (docs/plan-fleet-scheduling.md F5): every
# member runs it on its CPU, the GPU members and `--backend wasm` ones alike.
# Item i (OP_JOB, i = the u64 at job_base + arg) hashes the 8-byte LE
# encodings of i * param + j for j in 0..param with sha256d and returns the
# XOR of the hashes' first LE u32s; its job_out record is the first 16 bytes
# of sha256d(i as 8 LE bytes).  mesh-fleetcheck recomputes both with mesh-ref
# for every item, so a result in the wrong place or twice is caught.
# Setup ops (`setup 3:<i>`): 3 item i fails (R_JOB_FAIL, a poison item), 4
# item i traps (a fault: the program FAILS while it runs), 5 clears both.
name       = "hashjob"
abi        = 6
backends   = ["wasm"]
view_bytes = 0x1000
nodes      = 4
policy     = "job"
fanout     = 4
param      = 1024
job_base   = 0x08
job_out    = "0x100:16"
counters   = ["items", "khashes", "failed", ""]
fields     = ["items:u64:0x20", "hashes:u64:0x28", "last:u64:0x30", "fail_item:u32:0x10", "trap_item:u32:0x18"]
task_ms    = 2000
autostart  = false
# hello: task = arg * 3 + 7 (lifecycle tests; docs/plan-program-loading.md §3.3)
name       = "hello"
abi        = 6
view_bytes = 0x1000
view_abi   = 1
snap_bytes = 0x40
nodes      = 2
policy     = "on_demand"
counters   = ["tasks", "inits", "", ""]
fields     = ["magic:u32:0x0", "last_arg:u32:0x4", "last_result:u32:0x8"]
autostart  = true
backends   = ["cuda", "metal", "wasm"]
# http: an HTTP/1.0 GET server rendered on the GPU, generic over the program
# table (layout: mesh_abi::v2::views::http; docs/plan-program-loading.md §3.6)
name       = "http"
abi        = 6
view_bytes = 0xa9400
view_abi   = 2
snap_bytes = 0x40
nodes      = 1
policy     = "on_demand"
reads      = ["*"]
request    = "0x100:0x100,0x400:0xa9000"
counters   = ["", "", "", ""]
fields     = ["served:u32:0x0", "last_code:u32:0x4", "load_seq:u32:0x8", "load_ack:u32:0xc", "load_result:u32:0x10"]
autostart  = true
# infer: the trained cubic on a 64-point grid, reading train's view
# (layout: mesh_abi::v2::views::infer; docs/plan-program-loading.md §3.8)
name       = "infer"
abi        = 6
view_bytes = 0x1000
view_abi   = 1
snap_bytes = 0x400
nodes      = 1
policy     = "periodic"
hz         = 10
fanout     = 1
reads      = ["train"]
counters   = ["runs", "", "", ""]
fields     = ["a:f32:0x0", "b:f32:0x4", "c:f32:0x8", "d:f32:0xc", "runs:u32:0x10", "train_step:u32:0x14"]
autostart  = true
backends   = ["cuda", "metal", "wasm"]
# matmul: a deterministic shared-memory tiled f32 matrix multiply and
# matrix-vector product on the GPU (CUDA and Metal), in exact mode: every f32
# op correctly rounded and FTZ, never fused, and a fixed accumulation order
# (C[i][j] = ((0 + a0 b0) + a1 b1) + .. in k order; y[i]: lane l sums k = l,
# l + 32, .. in order, then the warp butterfly), so the bits equal
# mesh-ref::matmul's CPU reference on every GPU (kcheck GM*).  The seed of GPU
# inference (docs/plan-disagg-inference.md); tensor cores are the later fast mode.
# The matrices live in the program's scratch (device memory: A, B, C of up to
# 3072 x 3072, then x and y), generated on the device from a counter hash
# (mesh_ref::matmul::value), copied to the view's window on request.
# Ops: 3 SET arg = field << 24 | value (0 M, 1 K, 2 N: 1..=3072; 3 seed of A,
# 4 seed of B and x); 4 GEN arg = which << 24 | chunk (0 A, 1 B, 2 x; 65536
# elements a chunk); 5 MM arg = C tile (64 x 64, row-major tiles); 6 MV arg =
# 64-row block of y = A x (A M x K); 7 COPY arg = which << 24 | chunk (0 C, 1 y:
# 65536 floats into the window at 0x1000).
# View: 0x0 magic, 0x4 M, 0x8 K, 0xc N, 0x10 seed A, 0x14 seed B, 0x18 tiles done.
name          = "matmul"
abi           = 6
view_bytes    = 0x41000
nodes         = "fit"
warps         = 8
shared_bytes  = 0x2000
scratch_bytes = 0x6c08000
policy        = "on_demand"
fanout        = 32
counters      = ["tiles", "rows", "gens", "copies"]
fields        = ["m:u32:0x4", "k:u32:0x8", "n:u32:0xc", "seed_a:u32:0x10", "seed_b:u32:0x14", "tiles:u32:0x18"]
backends      = ["cuda", "metal"]
# pathtrace: a deterministic path tracer, one work item (a tile of 32 x 24, one pass) a task, one column a lane
# (renderer: crates/pathtrace-core; view layout: pathtrace_core::view; README "Pathtrace").
# The image is bit for bit the same on every backend and machine (the cluster float
# mode; counter-based random numbers; a fixed accumulation order), checked by kcheck's
# PT checks against mesh-ref's CPU reference.
# A job program: OP_JOB renders item job_base + arg = pass x tiles + tile (`job submit
# pathtrace items 9600`: the default 640x360 scene's 300 tiles x 32 passes of 8 samples),
# folded into its tile in pass order; the item's digests in its job_out record.  pathtrace-live (variants/) renders the same
# image progressively, pass by pass, on one meshd.
# OP_PASS (op 6) renders an item's pass sums only (no fold, no wait) into its job_payload
# slot: a fleet job (`job submit pathtrace items N op 6 setup 5:0,7:..`), whose items meshd keeps as
# blobs and any member assembles (README "Pathtrace across the fleet").
# fanout = 32: a Metal member's tickets in flight (one command buffer of 32 items, ~15-30 ms).
name       = "pathtrace"
abi        = 6
view_bytes = 0x41a000
view_abi   = 2
snap_bytes = 0x5600
nodes      = "fit"
warps      = 24
shared_bytes = 0x3400
policy     = "job"
fanout     = 32
job_base   = 0x100
job_out    = "0x200:32"
job_payload = "0x6000:9216"
request    = "0xa00:0x1000,0x1a00:0x100"
counters   = ["items", "tiles", "passes", "retones"]
fields     = ["tiles:u32:0x10", "done:u32:0x14", "next:u32:0x4", "tonemap:u32:0x8", "gen:u32:0xc", "width:u32:0x18", "height:u32:0x1c", "spp:u32:0x20", "passes:u32:0x24", "last_tile:u32:0x28", "last_system:u32:0x2c", "items:u32:0x38"]
autostart  = false
backends   = ["cuda", "metal", "wasm"]
# wasm: a whole tile on one CPU lane.
task_ms    = 20000
# pipehash: the pipe demo's GPU stage (layout: mesh_abi::v2::views::pipedemo, H_*).
# Its inbox takes `msg` records from a CPU source (pipesrc: wasm, pipesrc-n: native);
# each warp pops up to 32, its lanes hash one each (sha256d of the 64 bytes),
# and the warp pushes the `digest`s into a CPU sink (pipesink: native, pipesink-w: wasm).
# A sink without room for a warp's 32 stops the warp before it pops (backpressure up the pipe).
name       = "pipehash"
abi        = 6
view_bytes = 0x16000
inbox      = "0x80:1024:64"
inbox_type = "msg"
nodes      = 4
fanout     = 4
policy     = "continuous"
in_flight  = "free"
feeds      = ["pipesink:digest", "pipesink-w:digest"]
counters   = ["hashed", "stalls", "carried", ""]
fields     = ["dst:u32:0xc", "in_head:u32:0x80", "in_full:u32:0x84", "in_tail:u32:0xc0"]
autostart  = false
backends   = ["cuda", "metal"]
replicas   = 1  # a fleet runs one hashing stage (pipes are single-machine; its source and sinks are colocated with it)
# pipesink-w: pipesink's twin on the wasm executor (layout: mesh_abi::v2::views::pipedemo, K_*):
# drains `digest` records, checks each against mesh-ref's SHA-256 of the rebuilt msg,
# histograms the latency.  `task pipesink-w 2` refreshes the percentiles, `3` resets.
name       = "pipesink-w"
abi        = 6
backends   = ["wasm"]
float      = "ieee"
view_bytes = 0x3d000
inbox      = "0x4100:4096:48"
inbox_type = "digest"
nodes      = 2
fanout     = 2
policy     = "continuous"
in_flight  = "free"
counters   = ["records", "bad", "gpu", "cpu"]
fields     = ["records:u32:0x0", "bad:u32:0x4", "gpu:u32:0x8", "cpu:u32:0xc", "max_us:u32:0x10", "p50_us:u32:0x14", "p90_us:u32:0x18", "p99_us:u32:0x1c", "empty:u32:0x20", "in_head:u32:0x4100", "in_full:u32:0x4104", "in_tail:u32:0x4140"]
autostart  = false
colocate_with = "pipehash"  # a fleet: on the member(s) pipehash runs on (pipes are single-machine)
# pipesink: the pipe demo's checking sink, a native worker program (layout:
# mesh_abi::v2::views::pipedemo, K_*).  It drains its inbox of `digest` records,
# checks each against its own SHA-256 (mesh-ref) of the msg it rebuilds from the
# seq, and histograms the latency since the source stamped the msg (1 us bins).
# `task pipesink 2` refreshes the percentiles, `task pipesink 3` resets.
name       = "pipesink"
abi        = 6
backends   = ["native"]
view_bytes = 0x3d000
inbox      = "0x4100:4096:48"
inbox_type = "digest"
nodes      = 2
fanout     = 2
policy     = "continuous"
in_flight  = "free"
counters   = ["records", "bad", "gpu", "cpu"]
fields     = ["records:u32:0x0", "bad:u32:0x4", "gpu:u32:0x8", "cpu:u32:0xc", "max_us:u32:0x10", "p50_us:u32:0x14", "p90_us:u32:0x18", "p99_us:u32:0x1c", "empty:u32:0x20", "in_head:u32:0x4100", "in_full:u32:0x4104", "in_tail:u32:0x4140"]
autostart  = false
colocate_with = "pipehash"  # a fleet: on the member(s) pipehash runs on (pipes are single-machine)
# pipesrc-n: the pipe demo's CPU source as a native worker program (pipesrc's twin;
# layout: mesh_abi::v2::views::pipedemo, S_*).  Mode 0: `msg`s into pipehash's inbox;
# mode 1: `digest`s hashed here straight into a sink.
# `task pipesrc-n 2 <mode>`, `3 <batch>`, `4 <interval us>`, `5` resets.
name       = "pipesrc-n"
abi        = 6
backends   = ["native"]
view_bytes = 0x100
nodes      = 1
policy     = "continuous"
feeds      = ["pipehash:msg", "pipesink:digest", "pipesink-w:digest"]
counters   = ["sent", "full", "gone", ""]
fields     = ["mode:u32:0x0", "batch:u32:0x4", "interval_us:u32:0x8", "next_seq:u32:0xc", "sent:u32:0x10", "full:u32:0x14", "gone:u32:0x18", "dst:u32:0x28"]
autostart  = false
colocate_with = "pipehash"  # a fleet: on the member(s) pipehash runs on (pipes are single-machine)
# pipesrc: the pipe demo's CPU source, a wasm program (layout: mesh_abi::v2::views::pipedemo, S_*).
# Mode 0 pushes `msg` records into pipehash's inbox (the GPU hashes them);
# mode 1 hashes on the CPU and pushes `digest` records straight into a sink.
# `task pipesrc 2 <mode>`, `3 <batch>`, `4 <interval us>` (0: as fast as the pipe takes them), `5` resets.
name       = "pipesrc"
abi        = 6
view_bytes = 0x100
nodes      = 1
policy     = "continuous"
float      = "ieee"
backends   = ["wasm"]
feeds      = ["pipehash:msg", "pipesink:digest", "pipesink-w:digest"]
counters   = ["sent", "full", "gone", ""]
fields     = ["mode:u32:0x0", "batch:u32:0x4", "interval_us:u32:0x8", "next_seq:u32:0xc", "sent:u32:0x10", "full:u32:0x14", "gone:u32:0x18", "dst:u32:0x28"]
autostart  = false
colocate_with = "pipehash"  # a fleet: on the member(s) pipehash runs on (pipes are single-machine)
# sha-verify: kcheck's CPU check of sha256d's shares as a CPU program (wasm),
# running beside the GPU in production (docs/plan-fleet-scheduling.md §3.5).
# It reads sha256d's view (`reads`: the GPU -> CPU direction, zero copy), and
# re-hashes every new share of its share ring with mesh-ref's SHA-256: the hash
# must equal the GPU's and be under the target.  View: 0x0 verified, 0x4 bad
# (a hash that differs or misses the target), 0x8 missed (shares that left the
# 32-entry ring before a check), 0xc last checked share number, 0x10 sha256d's
# config generation it checked against, 0x14 the last nonce checked.
name       = "sha-verify"
abi        = 6
backends   = ["wasm"]
float      = "ieee"
view_bytes = 0x100
nodes      = 1
policy     = "periodic"
hz         = 50
reads      = ["sha256d"]
counters   = ["verified", "bad", "missed", ""]
fields     = ["verified:u32:0x0", "bad:u32:0x4", "missed:u32:0x8", "checked:u32:0xc", "gen:u32:0x10", "last_nonce:u32:0x14"]
autostart  = false
# sha256d: Bitcoin-style double SHA-256 nonce grinding (layout: programs/sha256d/src/lib.rs, V_*)
# A task grinds a chunk of 2^chunk_log2 nonces: OP_JOB the chunk a job's lease
# names (the fleet), OP_TASK the next from the view's chunk counter (`task`).
# param = chunk_log2, read by every image (PTX, program.metal, wasm) and part of
# the image hash, so every member of a mixed CUDA/Metal/wasm fleet grinds one
# chunk size (no runtime `chunk` setting).  2^16 since multi-warp nodes
# (README "Multi-warp tasks"): a node is 16 warps (512 threads, nonce = thread +
# 512 i), so a chunk is 64 iterations of 2 nonces a thread.  Before (one warp,
# 2^14), 2026-10-26: GB10 105.9 MH/s at 8 nodes; M3 Ultra 16.2 MH/s.
# Default demo target (OP_INIT, ZBITS_DEFAULT): 26 leading zero bits.  Measured on dgx-00 (GB10, shared
# with other tenants at ~96% load), 8 nodes: 51-55 MH/s, so 2^26 / rate = 1.2-1.3 s per share (32 nodes:
# 208-219 MH/s).  Change it live: `task sha256d 3 <bits>` (or `req`: "zbits <bits>", "nbits 1d00ffff").
# nodes = fanout = 8: a stop or a blink drains in a task or two (~0.4 ms on a GB10)
# while the other programs keep most of the GPU; 32 nodes (the per-program maximum) is 4x the rate.
# Jobs (plan F5): policy "job" -- meshd grinds nothing on its own; every chunk is an
# item of a fleet job (`job submit sha256d items 0- results nonzero setup 6:0`:
# grind continuously; a nonce window: `items a-b`), leased by the leader and run
# as OP_JOB (chunk = the u64 at job_base + arg), its shares in the item's job_out
# record.  fanout = 8: a Metal member's tickets in flight (one ~8 ms command buffer).
name       = "sha256d"
abi        = 6
view_bytes = 0x2000
view_abi   = 1
snap_bytes = 0x800
nodes      = 8
warps      = 16
shared_bytes = 0x60
policy     = "job"
fanout     = 8
job_base   = 0x1000
job_out    = "0x1800:32"
request    = "0x800:0x200,0xa00:0x200"
counters   = ["Mhash", "shares", "chunks", "stale"]
fields     = ["hashes:u64:0x10", "best_zbits:u32:0x30", "best_hi:u32:0x50", "best_nonce:u32:0x34", "shares:u32:0x2c", "found:u32:0xc", "last_nonce:u32:0x3c", "last_zbits:u32:0x5c", "target_zbits:u32:0x28", "version:u32:0x44", "time:u32:0x48", "nbits:u32:0x4c", "base:u32:0x20", "chunk_log2:u32:0x24", "system:u32:0x54", "gen:u32:0x4"]
autostart  = false
backends   = ["cuda", "metal", "wasm"]
param      = 16
# wasm (one lane a task; warps is the GPU shape): a 2^16-nonce chunk is ~30 ms on one core (2.2 MH/s); with up to 32 lanes on
# shared cores a task's wall time can stretch several-fold: 1 s before FAULT_TIME.
task_ms    = 1000
# tick: the scheduler's test program (docs/plan-fleet-scheduling.md F4): a
# periodic counter whose view carries state a migration must move.
# View: 0x0 magic "TICK" (init), 0x4 ticks, 0x8 inits (this view's OP_INITs),
# 0xc the last verify's mismatches; 0x40.. the pattern: word i is P(i) after
# init, and tick t overwrites word t mod W with P(t mod W) ^ (t + 1).
# `task tick 3 0` verifies 4096 words spread over the region and the last 64
# ticks' words (returns the mismatches; 0: the view is this view's own).
# Variants (variants/*.toml, the same images under other names): tick-w
# (wasm only), tick-m (metal only), tick-r (replicas 2), tick-big (a 6 MiB view).
name       = "tick"
abi        = 6
view_bytes = 0x10000
view_abi   = 1
snap_bytes = 0x40
nodes      = 1
policy     = "periodic"
hz         = 50
counters   = ["ticks", "inits", "", ""]
fields     = ["magic:u32:0x0", "ticks:u32:0x4", "inits:u32:0x8", "mismatches:u32:0xc"]
autostart  = false
backends   = ["cuda", "metal", "wasm"]
replicas   = 1
task_ms    = 2000
# train: SGD of a cubic on sin(pi x) samples, lockstep with a peer
# (layout: mesh_abi::v2::views::train; docs/plan-program-loading.md §3.8)
name       = "train"
abi        = 6
view_bytes = 0x1000
view_abi   = 1
snap_bytes = 0xd00
nodes      = 1
policy     = "continuous"
fanout     = 1
arg        = "view_u32:0x1c"
peer       = "lockstep"
counters   = ["steps", "timeouts", "inits", ""]
fields     = ["a:f32:0x0", "b:f32:0x4", "c:f32:0x8", "d:f32:0xc", "lr:f32:0x10", "steps_per_task:u32:0x14", "next_step:u32:0x1c", "step_hi:u32:0x2c", "err:u32:0x20", "pending:u32:0x24"]
autostart  = true
backends   = ["cuda", "metal", "wasm"]

