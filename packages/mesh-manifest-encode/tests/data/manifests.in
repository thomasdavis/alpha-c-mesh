fanout      = 4
in_flight   = "batch"
arg         = "index"
reads       = ["train"]
input       = 64
request     = "0x100:0x100,0x400:0x300"
peer        = "none"
counters    = ["frames", "", "", ""]
fields      = ["pos_x:f32:0x00", "frame:u32:0x20"]
autostart   = true
