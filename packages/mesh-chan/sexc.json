{
  "name": "@ajax/mesh-chan",
  "version": "0.1.0",
  "description": "A thread-safe channel of fixed-size messages with timeouts, as Rust's std::sync::mpsc",
  "kind": "library",
  "license": "MIT",
  "author": "Thomas Davis (C port); Richard Safier (alpha-rust-mesh)",
  "repository": "https://github.com/thomasdavis/alpha-c-mesh",
  "homepage": "https://github.com/thomasdavis/alpha-c-mesh/tree/main/packages/mesh-chan",
  "keywords": ["mesh", "alphaos", "channel", "mpsc", "threads"],
  "targets": ["host"],
  "cflags": ["-D_XOPEN_SOURCE=700", "-pthread"],
  "ldflags": ["-pthread"],
  "dependencies": {"@ajax/mesh-buf": "workspace:*", "@ajax/mesh-check": "workspace:*"}
}
