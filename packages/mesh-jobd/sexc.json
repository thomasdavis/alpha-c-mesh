{
  "name": "@ajax/mesh-jobd",
  "version": "0.1.0",
  "description": "meshd's jobs thread and blob thread: the job node over the peer links, the driver and the job log; the blob store's thread and its writers; the jobs view and the host block's job fields",
  "kind": "library",
  "license": "MIT",
  "author": "Thomas Davis (C port); Richard Safier (alpha-rust-mesh)",
  "repository": "https://github.com/thomasdavis/alpha-c-mesh",
  "homepage": "https://github.com/thomasdavis/alpha-c-mesh/tree/main/packages/mesh-jobd",
  "keywords": ["mesh", "alphaos", "jobs", "blobs", "daemon", "threads"],
  "targets": ["host"],
  "cflags": ["-D_XOPEN_SOURCE=700", "-pthread"],
  "ldflags": ["-pthread"],
  "dependencies": {
    "@ajax/mesh-check": "workspace:*",
    "@ajax/mesh-strbuf": "workspace:*",
    "@ajax/mesh-omap": "workspace:*",
    "@ajax/mesh-debug-str": "workspace:*",
    "@ajax/mesh-rs-parse": "workspace:*",
    "@ajax/mesh-abi-peer-frames": "workspace:*",
    "@ajax/mesh-abi-peer-sizes": "workspace:*",
    "@ajax/mesh-abi-host-jobs": "workspace:*",
    "@ajax/mesh-ref-sha256d": "workspace:*",
    "@ajax/mesh-shared": "workspace:*",
    "@ajax/mesh-chan": "workspace:*",
    "@ajax/mesh-reply": "workspace:*",
    "@ajax/mesh-views": "workspace:*",
    "@ajax/mesh-host-block": "workspace:*",
    "@ajax/mesh-log": "workspace:*",
    "@ajax/mesh-mailbox": "workspace:*",
    "@ajax/mesh-jobs-lid": "workspace:*",
    "@ajax/mesh-jobs-req": "workspace:*",
    "@ajax/mesh-jobs-node": "workspace:*",
    "@ajax/mesh-jobs-sched": "workspace:*",
    "@ajax/mesh-sched-member": "workspace:*",
    "@ajax/mesh-sched-needs": "workspace:*",
    "@ajax/mesh-sched-weights": "workspace:*",
    "@ajax/mesh-fleet-doc": "workspace:*",
    "@ajax/mesh-jobd-store": "workspace:*",
    "@ajax/mesh-jobd-text": "workspace:*",
    "@ajax/mesh-blobs-store": "workspace:*",
    "@ajax/mesh-blobs-durable": "workspace:*",
    "@ajax/mesh-blobd": "workspace:*",
    "@ajax/mesh-assemble": "workspace:*"
  }
}
